	t_test_fds		data;

	data = child_init(OUTPUT_PATH);
	child_redirect(&data, 1);
	child_redirect(&data, 2);
	if (ft_printf("ciao") != 0)
		return (-1);
	if (child_cmp(&data, LIBUNIT_FLAGS_ZERO, 1) != 0)
		return (-1);
	if (child_cmp(&data, LIBUNIT_FLAGS_EXIST, 2) != 0)
		return (-1);
	child_cleanup(&data);
	return (0);

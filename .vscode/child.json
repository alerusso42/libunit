{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug Libunit Tester",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/real-tests/test.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/real-tests",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Segui il figlio dopo una fork",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}